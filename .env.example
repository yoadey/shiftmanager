# ============================================================
# ShiftManager Environment Configuration
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================

# --- Server ---
# Port the HTTP server listens on inside the container / process
PORT=8080

# --- Database ---
# PostgreSQL connection string.
# For local dev: postgres://shiftmanager:password@localhost:5432/shiftmanager?sslmode=disable
# In Kubernetes: use the ClusterIP service name instead of localhost
DATABASE_URL=postgres://shiftmanager:password@localhost:5432/shiftmanager?sslmode=disable

# --- Redis (optional) ---
# Leave empty to fall back to in-memory caching / session store.
# In-memory is fine for a single-replica deployment; Redis enables session
# sharing across replicas and survives pod restarts.
REDIS_URL=redis://localhost:6379

# --- OIDC / Authentication ---
# Keycloak (or any OIDC-compliant IdP) settings.
# The issuer URL must match the 'iss' claim in tokens exactly.
OIDC_ISSUER=https://your-keycloak.example.com/realms/shiftmanager
OIDC_CLIENT_ID=shiftmanager
OIDC_CLIENT_SECRET=your-secret
# The OIDC callback endpoint. Must be registered VERBATIM as a valid redirect
# URI in the OIDC client config. Note the /api/v1 prefix — this is the backend
# route, not the SPA page.
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
# SPA route the backend redirects to after the callback, carrying the JWT (or an
# error code) in the URL fragment. Relative paths resolve against the server origin.
LOGIN_REDIRECT_URL=/auth/callback
# First-admin bootstrap: the member with this e-mail is auto-provisioned and
# promoted to an active administrator on login. Leave empty in production once
# an admin exists. Unknown users without this e-mail are registered but remain
# inactive until an admin activates them.
BOOTSTRAP_ADMIN_EMAIL=

# --- JWT ---
# Secret used to sign session / API JWTs.
# Generate a secure value: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-char-string

# --- Email / SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=shiftmanager@example.com
SMTP_PASS=your-password
# Display name and address used in the From: header
SMTP_FROM=ShiftManager <shiftmanager@example.com>

# --- Application ---
# Public base URL (used for building callback URLs, email links, etc.)
BASE_URL=http://localhost:8080

# Log level: trace | debug | info | warn | error | fatal | panic
LOG_LEVEL=info

# Go runtime memory limit — tune to ~80% of your container memory limit.
# See: https://pkg.go.dev/runtime/debug#SetMemoryLimit
GOMEMLIMIT=200MiB

# --- Club Branding ---
# Displayed in the UI before the club's branding is loaded from the database.
# Acts as a fallback if the DB record has not yet been configured.
CLUB_NAME=TSC Schwarz-Gelb Aachen
